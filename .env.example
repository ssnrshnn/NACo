# NACo environment variables. Copy this file to `.env` (or set them inline)
# before running `docker compose up`.
#
# Easiest path: run `./quickstart.sh` — it creates .env from this template
# with strong random values for every secret.
#
# Generate strong random values by hand:
#   python -c "import secrets;print(secrets.token_hex(32))"
#
# Anything marked REQUIRED has no default — compose will refuse to start
# without it.

# ── Compose profiles ────────────────────────────────────────────────────────
#   eap → FreeRADIUS sidecar for 802.1X (EAP-TLS / EAP-TTLS / PEAP) — DEFAULT
#   obs → Prometheus + Grafana + Loki + Promtail
# Remove `eap` if you only need PAP/CHAP/MAB from the built-in RADIUS server.
COMPOSE_PROFILES=eap

# ── Branding / image ────────────────────────────────────────────────────────
# Prebuilt multi-arch image published by .github/workflows/release.yml.
# Pin a version tag (e.g. :2.1.0) for production; compose builds from source
# automatically if the pull fails.
NACO_IMAGE=ghcr.io/ssnrshnn/naco:latest
NACO_DOMAIN=naco.example.com
NACO_TLS_EMAIL=admin@example.com

# ── PostgreSQL ──────────────────────────────────────────────────────────────
NACO_DB_USER=naco
NACO_DB_NAME=naco
NACO_DB_PASSWORD=REPLACE_ME_with_a_strong_postgres_password   # REQUIRED

# ── Application secrets ─────────────────────────────────────────────────────
NACO_SESSION_SECRET=REPLACE_ME_with_32_random_bytes_hex        # REQUIRED
NACO_API_SECRET=REPLACE_ME_with_32_random_bytes_hex            # REQUIRED
NACO_CSRF_SECRET=REPLACE_ME_with_32_random_bytes_hex           # REQUIRED
NACO_ADMIN_PASSWORD=REPLACE_ME_initial_admin_password          # REQUIRED — used only when seeding an empty DB

# Master key encrypting NAS secrets, TACACS+ keys and TOTP seeds at rest
# (AES-256-GCM). Generate with:  openssl rand -base64 32
# Losing this key makes those stored secrets unreadable — back it up.
NACO_MASTER_KEY=REPLACE_ME_with_openssl_rand_base64_32         # REQUIRED

# ── FreeRADIUS sidecar (802.1X / EAP — on by default) ───────────────────────
# Bearer token shared between NACo and FreeRADIUS; setting it on the NACo
# container auto-enables the /api/v1/eap/* endpoints.
NACO_EAP_BEARER_TOKEN=REPLACE_ME_with_32_random_bytes_hex
NACO_FREERADIUS_SHARED_SECRET=REPLACE_ME_with_32_random_bytes_hex

# ── Optional: Observability stack (--profile obs) ───────────────────────────
GRAFANA_ADMIN_PASSWORD=grafana

# ── Optional: development overrides ─────────────────────────────────────────
ACME_CA_DIRECTIVE=acme_ca https://acme-v02.api.letsencrypt.org/directory
# For local development set:
#   NACO_DOMAIN=localhost
#   ACME_CA_DIRECTIVE=acme_ca internal

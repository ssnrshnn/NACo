# Written by ./quickstart.sh — keep this file private (chmod 600) and back it
# up together with your database backups: without NACO_MASTER_KEY the stored
# switch secrets cannot be decrypted.

# Name or IP address administrators use to reach NACo.
NACO_HOST=nac.example.com
# An e-mail address for Let's Encrypt, or "internal" for Caddy's own CA
# (use "internal" for IP addresses and private names).
NACO_TLS=internal

# Secrets (generate with: openssl rand -base64 32 / openssl rand -hex 32).
NACO_MASTER_KEY=REPLACE_ME
NACO_INTERNAL_TOKEN=REPLACE_ME
# Initial administrator password, used only when the database is empty.
NACO_ADMIN_PASSWORD=REPLACE_ME
# Service account password, only if LDAP / Active Directory is enabled.
NACO_LDAP_BIND_PASSWORD=

# Time zone for timestamps in the panel and time-of-day policies.
TZ=UTC

# Released images instead of building locally (both, same version), e.g.
# NACO_IMAGE=ghcr.io/ssnrshnn/naco:3.0.0
# NACO_RADIUS_IMAGE=ghcr.io/ssnrshnn/naco-freeradius:3.0.0

# Internal Docker network (change only if it collides with your LAN).
NACO_SUBNET=172.30.0.0/24
NACO_IP_CADDY=172.30.0.10
NACO_IP_RADIUS=172.30.0.11
NACO_IP_APP=172.30.0.12

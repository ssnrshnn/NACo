# NACo environment variables. Copy this file to `.env` (or set them inline)
# before running `docker compose up`.
#
# Generate strong random values:
#   python -c "import secrets;print(secrets.token_hex(32))"
#
# Anything marked REQUIRED has no default — compose will refuse to start
# without it.

# ── Branding / image ────────────────────────────────────────────────────────
NACO_IMAGE=ghcr.io/your-org/naco:2.0.0
NACO_DOMAIN=naco.example.com
NACO_TLS_EMAIL=admin@example.com

# ── PostgreSQL ──────────────────────────────────────────────────────────────
NACO_DB_USER=naco
NACO_DB_NAME=naco
NACO_DB_PASSWORD=REPLACE_ME_with_a_strong_postgres_password   # REQUIRED

# ── Application secrets ─────────────────────────────────────────────────────
NACO_SESSION_SECRET=REPLACE_ME_with_32_random_bytes_hex        # REQUIRED
NACO_API_SECRET=REPLACE_ME_with_32_random_bytes_hex            # REQUIRED
NACO_CSRF_SECRET=REPLACE_ME_with_32_random_bytes_hex           # REQUIRED
NACO_ADMIN_PASSWORD=REPLACE_ME_initial_admin_password          # REQUIRED — used only when seeding an empty DB

# ── Optional: FreeRADIUS sidecar (--profile eap) ────────────────────────────
NACO_EAP_BEARER_TOKEN=REPLACE_ME_with_32_random_bytes_hex
NACO_FREERADIUS_SHARED_SECRET=REPLACE_ME_with_32_random_bytes_hex

# ── Optional: Observability stack (--profile obs) ───────────────────────────
GRAFANA_ADMIN_PASSWORD=grafana

# ── Optional: development overrides ─────────────────────────────────────────
ACME_CA_DIRECTIVE=acme_ca https://acme-v02.api.letsencrypt.org/directory
# For local development set:
#   NACO_DOMAIN=localhost
#   ACME_CA_DIRECTIVE=acme_ca internal

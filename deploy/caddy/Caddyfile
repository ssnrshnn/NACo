# NACo's front door: HTTPS for the admin panel and API, plain HTTP for the
# guest portal (captive-portal detection does not follow HTTPS).
#
#   NACO_HOST  the name or IP administrators use (from .env)
#   NACO_TLS   an e-mail address → Let's Encrypt, or "internal" → Caddy's own CA
#
# Only NACo's public port (8080) is proxied; its internal AAA API (8081) is
# never reachable from here. Caddy sets X-Forwarded-For to the real client
# address (it trusts no upstream proxy), and NACo trusts that header only
# from Caddy's fixed address.
{
	admin off
	# The http:// block below decides what plain HTTP does (the portal must
	# stay on HTTP), so Caddy's blanket HTTP→HTTPS redirect is off.
	auto_https disable_redirects
	# Clients send no SNI to an IP address; Caddy would then look for a
	# certificate for the container's own address and fail the handshake.
	default_sni {$NACO_HOST}
}

{$NACO_HOST} {
	tls {$NACO_TLS}
	encode zstd gzip
	header -Server
	reverse_proxy naco:8080
}

# Plain HTTP: the portal for guests; everything else goes to HTTPS (admin
# host) or to the portal (any other host — a captive-portal redirect).
http:// {
	header -Server
	@portal path /portal /portal/* /static/*
	handle @portal {
		reverse_proxy naco:8080
	}
	@admin host {$NACO_HOST}
	handle @admin {
		redir https://{host}{uri} permanent
	}
	handle {
		redir http://{$NACO_HOST}/portal 302
	}
}

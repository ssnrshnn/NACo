{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "title": "NACo Overview",
  "tags": ["naco", "radius", "tacacs", "nac"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "RADIUS Access-Accepts (/min)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "rate(naco_radius_accept_total[1m]) * 60", "legendFormat": "accepts" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "stat",
      "title": "RADIUS Access-Rejects (/min)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "rate(naco_radius_reject_total[1m]) * 60", "legendFormat": "rejects" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "type": "timeseries",
      "title": "Auth events by result",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (result) (rate(naco_auth_events_total[5m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Active sessions",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 6 },
      "targets": [
        { "expr": "naco_active_sessions", "legendFormat": "sessions" }
      ]
    }
  ]
}

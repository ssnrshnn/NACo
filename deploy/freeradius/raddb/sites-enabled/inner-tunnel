# Inside EAP-TTLS (PAP) and PEAP (GTC): check the inner credentials with
# NACo and remember the inner identity for the outer decision.
server inner-tunnel {
	authorize {
		# copy_request_to_tunnel copies the NAS's attributes, not ours.
		update request {
			&NACo-NAS-IP := &outer.request:NACo-NAS-IP
		}
		if (&outer.request:EAP-Type && &outer.request:EAP-Type == PEAP) {
			update request {
				&NACo-Auth-Method := "PEAP"
			}
		}
		else {
			update request {
				&NACo-Auth-Method := "EAP-TTLS"
			}
		}

		if (&EAP-Message) {
			eap {
				ok = return
				updated = return
			}
		}
		elsif (&User-Password) {
			update control {
				&Auth-Type := naco
			}
		}
		else {
			reject
		}
	}

	authenticate {
		Auth-Type naco {
			naco_token
			naco
		}
		eap
	}

	post-auth {
		update outer.session-state {
			&NACo-Inner-Identity := &User-Name
		}
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}

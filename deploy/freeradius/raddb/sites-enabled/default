server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}
	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		naco_nas_ip

		if (&EAP-Message) {
			eap {
				ok = return
				updated = return
			}
		}
		# MAB: the NAS says so (Call-Check), or a MAC as User-Name with the
		# same MAC — or no password at all (MikroTik, UniFi and Omada can send
		# none) — as User-Password. A MAC is no secret either way; NACo
		# additionally requires it to equal Calling-Station-Id.
		elsif (&Service-Type && &Service-Type == Call-Check) {
			naco_mab
		}
		elsif ((&User-Name =~ /^[0-9a-f]{2}([-:. ]?[0-9a-f]{2}){5}$/i || \
		        &User-Name =~ /^[0-9a-f]{4}[-:. ][0-9a-f]{4}[-:. ][0-9a-f]{4}$/i || \
		        &User-Name =~ /^[0-9a-f]{6}[-:. ][0-9a-f]{6}$/i) && \
		       (!&User-Password || &User-Password == "" || \
		        ("%{tolower:%{User-Password}}" == "%{tolower:%{User-Name}}"))) {
			naco_mab
		}
		elsif (&User-Password) {
			update request {
				&NACo-Auth-Method := "PAP"
			}
			update control {
				&Auth-Type := naco
			}
		}
		else {
			reject
		}

		# A NAS probing with Status-Server (Ruckus ICX does by default) gets
		# an answer only while NACo can decide; otherwise it marks this
		# server dead at once.
		Autz-Type Status-Server {
			naco_token
			naco_status {
				fail = 1
				invalid = 1
				notfound = 1
				userlock = 1
			}
			if (!ok) {
				fail
			}
		}
	}

	authenticate {
		Auth-Type naco {
			naco_token
			# 204 accept, 401 reject; anything else is no answer.
			naco {
				fail = 1
				invalid = 1
				notfound = 1
				userlock = 1
			}
			if (fail || invalid || notfound || userlock) {
				naco_unavailable
			}
		}
		eap
	}

	preacct {
		naco_nas_ip
	}

	accounting {
		naco_token
		naco
	}

	# The decision for every method: NACo answers control:NACo-Decision
	# (accept + VLAN and attributes, or reject). Without one, no answer.
	post-auth {
		if (!&NACo-Auth-Method && &EAP-Type) {
			if (&EAP-Type == TLS) {
				update request {
					&NACo-Auth-Method := "EAP-TLS"
				}
			}
			elsif (&EAP-Type == TTLS) {
				update request {
					&NACo-Auth-Method := "EAP-TTLS"
				}
			}
			elsif (&EAP-Type == PEAP) {
				update request {
					&NACo-Auth-Method := "PEAP"
				}
			}
		}
		if (&session-state:NACo-Inner-Identity) {
			update request {
				&NACo-Inner-Identity := &session-state:NACo-Inner-Identity
			}
		}
		naco_token
		naco {
			fail = 1
			invalid = 1
			notfound = 1
			userlock = 1
		}
		# Accept only on NACo's explicit decision.
		if (!&control:NACo-Decision) {
			naco_unavailable
		}
		elsif (&control:NACo-Decision != "accept") {
			reject
		}

		Post-Auth-Type REJECT {
			attr_filter.access_reject
			# A reject after a completed EAP method still carries that
			# method's EAP-Success: turn it into an EAP-Failure with the same
			# identifier. A failed method already answers EAP-Failure.
			if ("%{hex:&reply:EAP-Message}" =~ /^03([0-9a-f]{2})0004$/) {
				update reply {
					&EAP-Message := "0x04%{1}0004"
				}
			}
			eap
		}
	}
}

# Supported: EAP-TLS, EAP-TTLS (inner PAP) and PEAP (inner GTC).
# PEAP-MSCHAPv2 is deliberately absent: it needs reversible NT hashes, and
# NACo stores only bcrypt.
eap {
	default_eap_type = ttls
	timer_expire = 60
	ignore_unknown_eap_types = no
	max_sessions = ${max_requests}

	tls-config tls-common {
		private_key_file = ${certdir}/server.key
		certificate_file = ${certdir}/server.pem
		ca_file = ${certdir}/ca.pem
		auto_chain = yes
		cipher_list = "HIGH"
		cipher_server_preference = yes
		tls_min_version = "1.2"
		tls_max_version = "1.2"
		ecdh_curve = ""
		include_length = yes
		fragment_size = 1024
		cache {
			enable = no
		}
		ocsp {
			enable = no
		}
	}

	tls {
		tls = tls-common
	}

	ttls {
		tls = tls-common
		default_eap_type = gtc
		copy_request_to_tunnel = yes
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}

	peap {
		tls = tls-common
		default_eap_type = gtc
		copy_request_to_tunnel = yes
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}

	gtc {
		auth_type = naco
	}
}

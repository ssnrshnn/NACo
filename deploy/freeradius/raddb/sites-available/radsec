# RadSec — RADIUS over TLS (RFC 6614), port 2083/tcp.
#
# Terminates mutually-authenticated TLS and feeds the decrypted requests
# into the same `default` virtual server used for UDP: EAP is handled
# here, everything else (PAP/MAB) is delegated to NACo over
# /api/v1/eap/* — so a RadSec NAS gets the full policy engine.
#
# Client authentication is the TLS client certificate, not the shared
# secret: RFC 6614 §2.3 fixes the RADIUS secret at the literal string
# "radsec". Issue NAS client certificates from the same CA as the server
# certificate (see docs/RADSEC.md).

listen {
	ipaddr = *
	port = 2083
	type = auth+acct
	proto = tcp
	virtual_server = default
	clients = radsec

	limit {
		max_connections = 64
		lifetime = 0
		idle_timeout = 60
	}

	tls {
		private_key_file  = ${certdir}/server.key
		certificate_file  = ${certdir}/server.pem
		ca_file           = ${cadir}/ca.pem
		dh_file           = ${certdir}/dh
		fragment_size     = 8192
		tls_min_version   = "1.2"
		tls_max_version   = "1.3"
		cipher_list       = "DEFAULT"
		cipher_server_preference = no

		# Mutual TLS is the whole point of RadSec — a connection without
		# a certificate chained to our CA never reaches RADIUS parsing.
		require_client_cert = yes

		cache {
			enable = no
		}
	}
}

clients radsec {
	# Any source IP may connect; authorization is the client certificate.
	client radsec-clients {
		ipaddr = 0.0.0.0/0
		proto  = tls
		secret = radsec
	}
}

# EAP module — terminates the outer TLS tunnel for EAP-TLS / EAP-TTLS / PEAP.
#
# Certificates are generated by quickstart.sh into deploy/freeradius/certs/
# (mounted at /etc/raddb/certs). Replace them with PKI-issued ones for
# production; clients must trust ca.pem.
#
# Method support against NACo's bcrypt-hashed user store:
#   EAP-TTLS + PAP   ✅ inner plaintext password verified via /api/v1/eap/auth
#   PEAP + GTC       ✅ same
#   EAP-TLS          ✅ certificate-only (client certs signed by ca.pem)
#   PEAP + MSCHAPv2  ❌ requires reversible NT hashes NACo refuses to store

eap {
    default_eap_type = ttls
    timer_expire = 60
    ignore_unknown_eap_types = no
    max_sessions = ${max_requests}

    tls-config tls-common {
        private_key_file  = /etc/raddb/certs/server.key
        certificate_file  = /etc/raddb/certs/server.pem
        ca_file           = /etc/raddb/certs/ca.pem
        dh_file           = /etc/raddb/certs/dh
        ca_path           = /etc/raddb/certs
        cipher_list       = "DEFAULT"
        cipher_server_preference = no
        tls_min_version   = "1.2"
        tls_max_version   = "1.3"
        ecdh_curve        = "prime256v1"

        cache {
            enable = yes
            lifetime = 24 # hours
        }
    }

    ## EAP-TLS — client-certificate auth. Clients need a cert signed by ca.pem.
    tls {
        tls = tls-common
    }

    ## EAP-TTLS — inner PAP is proxied to NACo via the inner-tunnel server.
    ttls {
        tls = tls-common
        default_eap_type = gtc
        copy_request_to_tunnel = yes
        virtual_server = "inner-tunnel"
    }

    ## PEAP — use GTC inner (plaintext over the TLS tunnel) so NACo can verify
    ## against bcrypt. MSCHAPv2 is offered for clients that insist, but will
    ## fail without NT hashes.
    peap {
        tls = tls-common
        default_eap_type = gtc
        copy_request_to_tunnel = yes
        virtual_server = "inner-tunnel"
    }

    gtc {
        # Send the inner identity down the PAP path (→ rlm_rest → NACo).
        auth_type = rest
    }

    # No mschapv2 submodule on purpose: MSCHAPv2 needs reversible NT hashes,
    # which NACo's bcrypt-only user store cannot provide. Configure
    # supplicants for TTLS-PAP, PEAP-GTC, or EAP-TLS instead.
}
